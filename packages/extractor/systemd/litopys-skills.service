[Unit]
Description=Litopys daily skills detector (cluster episodes, draft SKILL.md)
Documentation=https://github.com/litopys-dev/litopys
After=network.target

[Service]
Type=oneshot
Environment=LITOPYS_GRAPH_PATH=%h/.litopys/graph
EnvironmentFile=-%h/.litopys/.env
ExecStart=litopys skills tick
StandardOutput=journal
StandardError=journal
SyslogIdentifier=litopys-skills

[Install]
WantedBy=default.target
